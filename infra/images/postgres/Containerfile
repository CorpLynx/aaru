# PostgreSQL 16.15 (Alpine) with gosu rebuilt from source.
# The official image ships gosu 1.19 built with Go 1.24.6, whose standard
# library has fixable CRITICAL and HIGH CVEs. The entrypoint runs gosu once, as
# root, to drop to the postgres user. This rebuilds gosu 1.20 from its release
# commit with the current Go. Drop this image once the official one ships a
# gosu built with a fixed Go.

ARG BASE_IMAGE=docker.io/library/postgres@sha256:0cefaabd882e42bcb2a2f3dc56d3ce4770560ba62fd7f197f1a2e008fd5731ab

# golang 1.27.3-alpine3.24
FROM docker.io/library/golang@sha256:d200d2dd76b03a99b52651fd1325aff7dcd35422c35c01bac56571b0507f3deb AS gosu
# tianon/gosu 1.20; the archive's SHA-256 is checked before it is built.
ARG GOSU_COMMIT=29b939aa5bd4dc588af765b8248f6e39150d2565
ARG GOSU_SHA256=2b70da8a5480fafedc16bb1fc91b572f064d03df736cbd91a616af2f1b66ab51
ENV CGO_ENABLED=0 GOTOOLCHAIN=local
RUN set -eux; \
    wget -qO /tmp/gosu.tar.gz "https://github.com/tianon/gosu/archive/${GOSU_COMMIT}.tar.gz"; \
    echo "${GOSU_SHA256}  /tmp/gosu.tar.gz" | sha256sum -c -; \
    mkdir /src; tar -xzf /tmp/gosu.tar.gz -C /src --strip-components=1; \
    cd /src; go mod verify; \
    go build -trimpath -buildvcs=false -ldflags '-d -w' -o /gosu .; \
    /gosu --version

FROM ${BASE_IMAGE}
COPY --from=gosu /gosu /usr/local/bin/gosu
RUN set -eux; gosu --version; gosu nobody true; su-exec nobody true
