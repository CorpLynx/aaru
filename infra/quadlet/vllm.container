[Unit]
Description=vLLM Inference Server (CUDA) — Interim Test Hardware
After=network-online.target aaru-internal-network.service
Wants=network-online.target

[Container]
# Pinned by digest to aaru-vllm: v0.33.0 with security updates (infra/images/vllm).
# CUDA 13 only: needs an NVIDIA driver that supports CUDA 13.0; never use a floating tag (see litellm.container).
# Must stay at 0.31.0 or later: CVE-2026-114053 (critical RCE via mm_processor_kwargs).
Image=ghcr.io/corplynx/aaru-vllm@sha256:da00b782c342bd3d473de882ec89fcd8c18f29f44781132caf55780acadaf834
ContainerName=vllm
Network=aaru-internal.network:ip=10.231.0.21
# No host port published — internal only
# The GPU through CDI, which also injects the host driver's libcuda. Raw /dev/nvidia*
# nodes alone leave the container without a driver. Generate the spec once as root:
#   nvidia-ctk cdi generate --output=/etc/cdi/nvidia.yaml
AddDevice=nvidia.com/gpu=all
SecurityLabelType=container_t
NoNewPrivileges=true
DropCapability=ALL
ReadOnly=true
# vLLM and Triton write compile caches under $HOME; keep them off the read-only root.
Environment=HOME=/var/cache/vllm
Tmpfs=/var/cache/vllm:size=4g
ShmSize=2g
Environment=HF_HUB_OFFLINE=1
Environment=VLLM_NO_USAGE_STATS=1
Environment=DO_NOT_TRACK=1
Volume=%h/aaru/models:/models:ro,z
# aaru-internal has no egress, so the model is staged on the host first with
# infra/scripts/fetch-model.sh. The model, its arguments and the memory limit
# depend on the test GPU and live in vllm.container.d/local.conf (gitignored;
# see local.conf.example). The image's entrypoint is `vllm serve`.
HealthCmd=python3 -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')"
HealthInterval=30s
HealthRetries=3
HealthStartPeriod=300s

[Service]
Restart=on-failure
TimeoutStartSec=300

[Install]
WantedBy=default.target
