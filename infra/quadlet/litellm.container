[Unit]
Description=LiteLLM API Gateway
After=network-online.target postgres.service
Wants=network-online.target

[Container]
Image=ghcr.io/berriai/litellm:main-stable
ContainerName=litellm
Network=aaru-ingress.network
Network=aaru-internal.network:ip=10.231.0.30
# aaru-internal has no DNS (see aaru-internal.network)
AddHost=postgres:10.231.0.10
AddHost=llamacpp:10.231.0.20
AddHost=vllm:10.231.0.21
PublishPort=127.0.0.1:4000:4000
Volume=%h/aaru/infra/config/litellm_config.yaml:/app/config.yaml:ro,z
# Without --config the image ignores the mounted file and serves no models.
Exec=--config /app/config.yaml --port 4000
Secret=litellm-master-key,type=env,target=LITELLM_MASTER_KEY
Secret=litellm-database-url,type=env,target=DATABASE_URL
HealthCmd=python3 -c "import urllib.request; urllib.request.urlopen('http://localhost:4000/health')"
HealthInterval=30s
HealthRetries=3
HealthStartPeriod=30s
NoNewPrivileges=true
ReadOnly=true
Tmpfs=/tmp:size=100m
Memory=2g

[Service]
Restart=on-failure
TimeoutStartSec=120

[Install]
WantedBy=default.target