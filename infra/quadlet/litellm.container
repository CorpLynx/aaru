[Unit]
Description=LiteLLM API Gateway
After=network-online.target postgres.service
Wants=network-online.target

[Container]
# Pinned by digest to aaru-litellm: v1.106.6 (the current stable release) with
# bundled packages patched (infra/images/litellm).
# Never use a floating tag here. LiteLLM's release pipeline was compromised in
# October 2026 via stolen GitHub CLI OAuth tokens; version 1.107.0 shipped a
# credential stealer and a backdoor, and the malicious images were published
# under the ordinary release tags. A floating tag pulls whatever was pushed
# last, with no review step.
# The old signing key (commit 0112e53) was probably exposed in that incident and
# was rotated on 2026-10-23 (BerriAI/litellm #48103, #48215). Images from
# v1.106.3 on verify only against the new key; do not trust the old one for
# anything newer. The new key's cosign.pub has SHA-256
# e3fe3e08c44b16407fe0b37c43b4f8b603b3a0f4ee74c29e647bc022d762c2c0, as also
# published in LiteLLM's incident post.
# Verify the upstream base before bumping it in infra/images/litellm:
#   cosign verify --key https://raw.githubusercontent.com/BerriAI/litellm/e82a3c646908ba0a6ee0beddc4310d7a6cac4065/cosign.pub \
#     ghcr.io/berriai/litellm@sha256:37e2dafb088a7723beb998590682957386dfc83ffea1848486f8e0e5cfac0b06
Image=ghcr.io/corplynx/aaru-litellm@sha256:e4ccfb0e6a500c1d53a294f541b4cea1ca4bcb2acd4063448e9ba74df6b5db3a
ContainerName=litellm
Network=aaru-ingress.network
Network=aaru-internal.network:ip=10.231.0.30
# aaru-internal has no DNS (see aaru-internal.network)
AddHost=postgres:10.231.0.10
AddHost=llamacpp:10.231.0.20
AddHost=vllm:10.231.0.21
PublishPort=127.0.0.1:4000:4000
# The whole directory, so config.yaml can include the host-specific models.yaml.
Volume=%h/aaru/infra/config/litellm:/app/config:ro,z
# Without --config the image ignores the mounted file and serves no models.
Exec=--config /app/config/config.yaml --port 4000
Secret=litellm-master-key,type=env,target=LITELLM_MASTER_KEY
Secret=litellm-database-url,type=env,target=DATABASE_URL
# llama-swap requires this key on every inference route (models.yaml uses it).
Secret=llama-swap-api-key,type=env,target=LLAMA_SWAP_API_KEY
HealthCmd=python3 -c "import urllib.request; urllib.request.urlopen('http://localhost:4000/health')"
HealthInterval=30s
HealthRetries=3
HealthStartPeriod=30s
NoNewPrivileges=true
DropCapability=ALL
ReadOnly=true
Tmpfs=/tmp:size=100m
Memory=2g

[Service]
Restart=on-failure
TimeoutStartSec=120

[Install]
WantedBy=default.target