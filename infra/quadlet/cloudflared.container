[Unit]
Description=Cloudflare Tunnel
After=network-online.target openwebui.service litellm.service
Wants=network-online.target

[Container]
# Pinned by digest to 2026.10.7; never use a floating tag (see litellm.container).
Image=docker.io/cloudflare/cloudflared@sha256:4955524aeaa379e154023d5a027c250f7b35041a2e7e950cf13f144bc9b9c5ba
ContainerName=cloudflared
# Ingress only: no route to PostgreSQL or inference (spec §9).
Network=aaru-ingress.network
Exec=tunnel run
Secret=cloudflared-token,type=env,target=TUNNEL_TOKEN
NoNewPrivileges=true
DropCapability=ALL
ReadOnly=true
Memory=256m

[Service]
Restart=on-failure
TimeoutStartSec=60

[Install]
WantedBy=default.target