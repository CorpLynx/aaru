[Unit]
Description=Aaru Encrypted S3 Backup
After=network-online.target postgres.service
Wants=network-online.target
OnFailure=aaru-notify@%n.service

[Service]
Type=oneshot
# Bucket, KMS key ARN and region; written by infra/scripts/set-backup-credentials.sh.
# AWS credentials are not here: backup.sh reads them from the aaru-backup-aws Podman secret.
EnvironmentFile=%h/.config/aaru/backup.env
ExecStart=/bin/bash %h/aaru/infra/scripts/backup.sh
TimeoutStartSec=1800
StandardOutput=journal
StandardError=journal
