[Unit]
Description=PostgreSQL Database
After=network-online.target
Wants=network-online.target

[Container]
# Pinned by digest to 16.15-alpine; never use a floating tag (see litellm.container).
Image=docker.io/library/postgres@sha256:f4610795587492cd4fb887c2dc3de301b813278bb6f616992061141b5f15ac36
ContainerName=postgres
Network=aaru-internal.network:ip=10.231.0.10
Volume=postgres-data.volume:/var/lib/postgresql/data:Z
Environment=POSTGRES_USER=aaru
Environment=POSTGRES_DB=aaru
Secret=postgres-password,type=env,target=POSTGRES_PASSWORD
# Separate database and least-privilege role per service (spec §2).
# The init script runs on first start of an empty data volume only.
Volume=%h/aaru/infra/config/postgres-init:/docker-entrypoint-initdb.d:ro,z
Secret=litellm-db-password,type=mount
Secret=openwebui-db-password,type=mount
HealthCmd=pg_isready -U aaru -d aaru
HealthInterval=10s
HealthRetries=5
HealthStartPeriod=30s
NoNewPrivileges=true
Memory=2g

[Service]
Restart=on-failure
TimeoutStartSec=120

[Install]
WantedBy=default.target