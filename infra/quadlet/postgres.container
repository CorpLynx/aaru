[Unit]
Description=PostgreSQL Database
After=network-online.target
Wants=network-online.target

[Container]
Image=docker.io/library/postgres:16-alpine
ContainerName=postgres
Network=aaru-internal.network
Volume=postgres-data.volume:/var/lib/postgresql/data:Z
Environment=POSTGRES_USER=aaru
Environment=POSTGRES_PASSWORD={env:POSTGRES_PASSWORD}
Environment=POSTGRES_DB=aaru
Secret=postgres-password,type=env,target=POSTGRES_PASSWORD
HealthCmd=pg_isready -U aaru -d aaru
HealthInterval=10s
HealthRetries=5
HealthStartPeriod=30s
NoNewPrivileges=true
Memory=2g

[Service]
Restart=on-failure
TimeoutStartSec=120

[Install]
WantedBy=default.target