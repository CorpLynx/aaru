# Secrets and credentials (also enforced by infra/scripts/ci-policy.sh and gitleaks)
*.env
*.env.*
*.secret
secrets/
credentials/
*.pem
*.key
*.p12
*.pfx
*.jks
id_rsa*
id_ed25519*
id_ecdsa*
*.kubeconfig
*credentials*.json
*.tfplan

# OS files
.DS_Store
._*

# Models (large binary files), one directory per model
models/

# Host-specific settings: model choice, memory limits (see the *.example files)
infra/quadlet/*.container.d/local.conf
infra/config/litellm/models.yaml
infra/config/llama-swap/config.yaml

# Backup staging
backup-staging/

# Legal pages: operator details and the rendered site (see legal/README.md)
legal/legal.conf
legal/site/

# Podman volumes and runtime data
data/
*.log

# Node/Python
node_modules/
__pycache__/
*.pyc

# Build artifacts
dist/
build/

# Terraform state and local backend config
**/.terraform/
**/*.tfstate
**/*.tfstate.*
**/backend.hcl
**/terraform.tfvars
**/override.tf
**/override.tofu
crash.log

# Local clone of CorpLynx/aaru-web (the web app); it has its own repository
web/
# Local clone of CorpLynx/Anubis (the model scanner); built by build-anubis-image.sh
anubis/
