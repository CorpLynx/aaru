#!/usr/bin/env bash
# Scans every commit about to leave this machine, including ones made before
# the pre-commit hook was installed or with --no-verify.
# Installed by infra/scripts/install-git-hooks.sh.

set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

command -v gitleaks >/dev/null 2>&1 \
    || { echo "pre-push: gitleaks is not installed (brew install gitleaks); refusing to push unscanned." >&2; exit 1; }

# Commits on local branches that no remote has yet.
gitleaks git --log-opts="--branches --not --remotes" --redact --no-banner --config .gitleaks.toml . \
    || { echo "pre-push: gitleaks found a possible secret in commits being pushed. Remove it from history before pushing (and rotate it)." >&2; exit 1; }
